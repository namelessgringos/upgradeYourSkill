rules_version = '2';

// Non-negotiable rule #1 and #4: the client never reads skill documents
// (they contain the server-only system prompt) and never writes entitlement
// or usage. Everything goes through entitlement-checked Cloud Functions,
// which use the Admin SDK and bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
