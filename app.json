{
  "expo": {
    "name": "Skills Coach",
    "slug": "skills-coach",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "skillscoach",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skillscoach.app"
    },
    "android": {
      "package": "com.skillscoach.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-localization",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
